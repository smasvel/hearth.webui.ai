# User service template: adjust the checkout path before installing.
[Unit]
Description=LM Studio tool-calling compatibility shim
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/ai-webui
ExecStart=%h/ai-webui/.venv/bin/python %h/ai-webui/lmstudio_tool_shim.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
