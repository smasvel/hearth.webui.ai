# User service template: adjust the checkout path before installing.
[Unit]
Description=LM Studio tool-calling compatibility shim
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/ai-webui
Environment=PYTHONPATH=%h/ai-webui
ExecStart=%h/ai-webui/.venv/bin/python -m hearth.backends.lmstudio_tool_shim
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
