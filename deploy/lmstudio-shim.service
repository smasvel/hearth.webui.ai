# User service template: adjust the checkout path before installing.
[Unit]
Description=Hearth LM Studio API compatibility and metrics proxy
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/ai-webui
ExecStart=%h/ai-webui/.venv/bin/python %h/ai-webui/lmstudio_shim.py
ExecStartPost=%h/ai-webui/.venv/bin/python %h/ai-webui/wire_lmstudio_proxy.py
Restart=on-failure
RestartSec=3
TimeoutStartSec=60

[Install]
WantedBy=default.target
